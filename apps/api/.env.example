NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://pacient:pacient@localhost:5432/pacient
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
CORS_ORIGINS=http://localhost:5173
# Public URL of the web app, used to build account-activation links
WEB_APP_URL=http://localhost:5173
LOG_LEVEL=info
# Number of reverse proxies in front of the API (for client IPs in audit logs)
TRUST_PROXY=0
# Encrypts MFA secrets at rest (required in production). Generate like JWT_ACCESS_SECRET.
MFA_ENCRYPTION_KEY=
# Require two-step sign-in for doctors, directors and Ministry staff (default: true in production)
REQUIRE_STAFF_MFA=false
# Professional licence check on clinical entries: on | warn | off (default: on in production, warn
# otherwise – the action proceeds with an X-Licence-Warning header).
LICENCE_ENFORCEMENT=
# Email: smtp | log | memory. Development default is "log" (emails appear in the API log) unless
# SMTP_URL is set – e.g. run Mailpit (docker run -p 1025:1025 -p 8025:8025 axllent/mailpit) and use
# SMTP_URL=smtp://localhost:1025, then open http://localhost:8025.
EMAIL_TRANSPORT=
SMTP_URL=
EMAIL_FROM="Pacient <no-reply@pacient.local>"
EMAIL_WORKER=true

# SMS alerts. Development default: `log` (codes appear in the API log). Production uses Twilio when
# all three TWILIO/SMS_FROM values are set; otherwise texts are held in the outbox.
# SMS_PROVIDER=log
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# SMS_FROM=+38344000000
# SMS_DEFAULT_COUNTRY_CODE=+383
# SMS_QUIET_HOURS=22-7
# SMS_TIMEZONE=Europe/Belgrade

# Malware scanning of uploaded documents: off (default) or clamav (needs a clamd daemon).
# DOCUMENT_SCANNER=clamav
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310

# Document storage: db (default – encrypted in PostgreSQL) or s3 (encrypted objects in S3-compatible
# storage: AWS S3, MinIO, Ceph). Documents are encrypted by the API before upload. Existing
# documents keep working where they are; move them with `npm run documents:migrate-to-s3 -w apps/api`.
# Production requires an https endpoint. See deploy/README.md ("Object storage").
# STORAGE_BACKEND=s3
# STORAGE_S3_ENDPOINT=http://localhost:9000
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_BUCKET=pacient-documents
# STORAGE_S3_ACCESS_KEY_ID=pacient
# STORAGE_S3_SECRET_ACCESS_KEY=pacient-dev-secret
# STORAGE_S3_FORCE_PATH_STYLE=true
# STORAGE_S3_SSE=AES256
# STORAGE_S3_TIMEOUT_MS=15000
